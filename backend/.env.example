# Todas las variables son opcionales: la aplicación funciona sin crear un archivo .env.

# Puerto del backend
PORT=3000

# Origen permitido por CORS (dirección del frontend)
CORS_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite. Por defecto: backend/data/agents.db
# DATABASE_PATH=./data/agents.db

# Proveedor de IA: mock (simulado, por defecto), anthropic (Claude) u openai.
# AI_PROVIDER=anthropic

# Clave de la API de Claude. Obligatoria con AI_PROVIDER=anthropic.
# Nunca la subas al repositorio: backend/.env está en .gitignore.
# ANTHROPIC_API_KEY=

# Clave de la API de OpenAI. Obligatoria con AI_PROVIDER=openai.
# OPENAI_API_KEY=

# Modelo del proveedor real. Por defecto: claude-haiku-5-5 (anthropic) o gpt-6.1-terra (openai)
# AI_MODEL=
