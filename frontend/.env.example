# Opcional: la aplicación funciona sin crear un archivo .env.

# Dónde está el backend para el proxy de Vite (solo `npm run dev`).
# Cámbialo si arrancas el backend con otro PORT.
API_PROXY_TARGET=http://localhost:3000

# Dirección de la API que usa el navegador. Por defecto `/api` (el proxy).
# Solo si quieres llamar al backend directamente; entonces necesita CORS_ORIGIN.
# VITE_API_URL=http://localhost:3000/api
